---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { en } from '../../i18n';

// 只为有站内正文（未填 url）的文章生成阅读页
export async function getStaticPaths() {
  const posts = await getCollection('thoughts', ({ data }) => !data.draft && !data.url);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data.date;
const date = `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---
<Base
  title={`${post.data.title} · ice`}
  description={post.data.summary ?? post.data.title}
  titleEn={post.data.titleEn && `${post.data.titleEn} · ice`}
  descriptionEn={post.data.summaryEn ?? post.data.titleEn}
>
  <article class="article">
    <a class="article__back nav-link t-small" href="/#thoughts" {...en('← Back to thoughts')}>← 返回我的思考</a>
    <time class="t-small" datetime={d.toISOString()}>{date}</time>
    <h1 class="article__title t-title" {...en(post.data.titleEn)}>{post.data.title}</h1>
    <div class="article__body">
      <Content />
    </div>
  </article>
</Base>
